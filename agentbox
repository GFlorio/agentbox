#!/usr/bin/env python3

from __future__ import annotations

import argparse
from collections.abc import Callable
from dataclasses import dataclass
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import secrets
import shlex
import shutil
import subprocess
import sys
import tarfile


CONTAINERFILE = "Containerfile.dev"
DEFAULT_IMAGE = os.environ.get(
    "AGENTBOX_DEFAULT_IMAGE",
    "ghcr.io/gflorio/agentbox:latest",
)
WORKSPACE_PATH = "/workspace"
AGENT_HOME = "/home/agent"
IMAGE_HASH_LABEL = "dev.agentbox.containerfile-sha256"
PROJECT_PATH_LABEL = "dev.agentbox.project-path"

RESOURCE_PREFIX = "agentbox-"
IMAGE_PREFIX = "localhost/agentbox-"

# OpenCode keeps credentials in its data directory and the selected model in
# its state directory. Both files are shared by every project so that a single
# `agentbox auth` and model choice cover all worktrees.
SHARED_VOLUME = "agentbox-shared"
SHARED_VOLUMES = (SHARED_VOLUME,)

OPENCODE_DATA_PATH = f"{AGENT_HOME}/.local/share/opencode"
OPENCODE_STATE_PATH = f"{AGENT_HOME}/.local/state/opencode"

# Mounted one level below the agent home, and never deeper. Podman creates
# missing intermediate mountpoints as root inside the home volume, and those
# directories are not overlaid by anything, so their parents become unwritable
# by the agent. A single-level mountpoint is the volume itself, which the U
# flag chowns to the agent.
#
# Individual files are linked out of it rather than mounting over the OpenCode
# directories, which would also share opencode.db and make session history
# common to every worktree.
SHARED_PATH = f"{AGENT_HOME}/.agentbox-shared"

SHARED_LINKS = (
    (OPENCODE_DATA_PATH, "auth.json"),
    (OPENCODE_STATE_PATH, "model.json"),
)

SHARED_VOLUME_MOUNTS = ((SHARED_VOLUME, SHARED_PATH),)

GLOBAL_CONFIG_PATH = f"{AGENT_HOME}/.config/opencode"

# The host config directory is mounted whole, one level below the agent home
# for the reason given above, and its entries are linked into the path OpenCode
# reads. opencode.jsonc is present here but never linked.
GLOBAL_CONFIG_MOUNT = f"{AGENT_HOME}/.agentbox-config"

# The box ships its own opencode.json; the host copy must not override it.
GLOBAL_CONFIG_EXCLUDED = frozenset({"opencode.jsonc"})

# Kept alongside the mounted subdirectories because it is OpenCode's manifest
# of npm-installed global plugins.
GLOBAL_CONFIG_FILES = frozenset({"package.json"})


class AgentboxError(RuntimeError):
    """Expected agentbox failure with a user-facing error message."""


@dataclass(frozen=True)
class Resource:
    """A podman container, volume, or image created by agentbox."""

    kind: str
    name: str
    identifier: str
    project_path: str | None
    shared: bool = False


def run(
    command: list[str],
    *,
    cwd: Path | None = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=cwd,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise AgentboxError(f"Required command not found: {name}")


def find_project_root(start: Path) -> Path:
    result = run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=start,
        capture=True,
        check=False,
    )

    if result.returncode != 0:
        raise AgentboxError(f"Not inside a Git working tree: {start}")

    return Path(result.stdout.strip()).resolve()


def project_key(root: Path) -> str:
    path_digest = hashlib.sha256(
        str(root).encode("utf-8")
    ).hexdigest()[:10]

    safe_name = "".join(
        character if character.isalnum() else "-"
        for character in root.name.lower()
    ).strip("-")

    return f"{safe_name}-{path_digest}"


def containerfile_path(root: Path) -> Path | None:
    path = root / CONTAINERFILE
    return path if path.is_file() else None


def image_name(root: Path) -> str:
    if containerfile_path(root) is not None:
        return f"localhost/agentbox-{project_key(root)}:dev"
    return DEFAULT_IMAGE


def home_volume_name(root: Path) -> str:
    return f"agentbox-{project_key(root)}-home"


def container_name(root: Path, kind: str, session: str) -> str:
    return f"agentbox-{project_key(root)}-{kind}-{session}"


def state_root(root: Path) -> Path:
    default_state_home = Path.home() / ".local" / "state"
    xdg_state_home = Path(
        os.environ.get("XDG_STATE_HOME", default_state_home)
    )

    return xdg_state_home / "agentbox" / project_key(root)


def containerfile_hash(root: Path) -> str:
    containerfile = root / CONTAINERFILE

    return hashlib.sha256(
        containerfile.read_bytes()
    ).hexdigest()


def image_exists(name: str) -> bool:
    result = run(
        ["podman", "image", "exists", name],
        check=False,
    )

    return result.returncode == 0


def image_containerfile_hash(name: str) -> str | None:
    result = run(
        [
            "podman",
            "image",
            "inspect",
            name,
            "--format",
            f'{{{{ index .Labels "{IMAGE_HASH_LABEL}" }}}}',
        ],
        capture=True,
        check=False,
    )

    if result.returncode != 0:
        return None

    value = result.stdout.strip()

    if not value or value == "<no value>":
        return None

    return value


def build_image(
    root: Path,
    *,
    no_cache: bool = False,
) -> None:
    containerfile = containerfile_path(root)

    if containerfile is None:
        raise AgentboxError(
            f"{root} does not contain {CONTAINERFILE}"
        )

    uid = os.getuid()
    gid = os.getgid()
    digest = containerfile_hash(root)
    name = image_name(root)

    command = [
        "podman",
        "build",
        "--tag",
        name,
        "--label",
        f"{IMAGE_HASH_LABEL}={digest}",
        "--label",
        f"{PROJECT_PATH_LABEL}={root}",
        "--build-arg",
        f"USER_ID={uid}",
        "--build-arg",
        f"GROUP_ID={gid}",
        "--file",
        str(containerfile),
    ]

    if no_cache:
        command.extend(
            [
                "--no-cache",
                "--pull=always",
            ]
        )

    command.append(str(root))

    print(f"Building {name}...")

    result = subprocess.run(
        command,
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    if result.returncode != 0:
        if result.stdout:
            print(result.stdout, file=sys.stderr, end="")

        raise subprocess.CalledProcessError(
            result.returncode,
            command,
            output=result.stdout,
        )

    print("Development image ready.")


def pull_default_image(*, refresh: bool = False) -> None:
    if not refresh and image_exists(DEFAULT_IMAGE):
        return

    print(f"Pulling {DEFAULT_IMAGE}...")
    run(["podman", "pull", DEFAULT_IMAGE])


def ensure_image(
    root: Path,
    *,
    rebuild: bool = False,
) -> None:
    if containerfile_path(root) is None:
        pull_default_image(refresh=rebuild)
        return

    name = image_name(root)

    if rebuild:
        build_image(root)
        return

    if not image_exists(name):
        build_image(root)
        return

    expected_hash = containerfile_hash(root)
    actual_hash = image_containerfile_hash(name)

    if actual_hash != expected_hash:
        print(
            f"{CONTAINERFILE} changed; "
            "rebuilding development image."
        )
        build_image(root)


def session_suffix() -> str:
    timestamp = datetime.now(timezone.utc).strftime(
        "%y%m%d%H%M%S"
    )

    return f"{timestamp}-{secrets.token_hex(3)}"


def validate_session_name(value: str) -> str:
    allowed = set(
        "abcdefghijklmnopqrstuvwxyz"
        "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-"
    )

    if (
        not value
        or not value[0].isalnum()
        or any(character not in allowed for character in value)
    ):
        raise AgentboxError(
            "--name must start with a letter or digit and "
            "contain only letters, digits, '.', '_' or '-'"
        )

    return value


def git_output(
    root: Path,
    arguments: list[str],
) -> str:
    result = run(
        ["git", *arguments],
        cwd=root,
        capture=True,
    )

    return result.stdout


def git_config_value(root: Path, key: str) -> str | None:
    result = run(
        ["git", "config", "--get", key],
        cwd=root,
        capture=True,
        check=False,
    )

    if result.returncode != 0:
        return None

    value = result.stdout.strip()

    return value or None


def git_identity_env(root: Path) -> list[str]:
    """
    Expose the host Git identity to the container.

    GIT_CONFIG_* entries are read by `git config --get` too, so the agent
    sees the same user.name and user.email the host does.
    """

    entries = [
        ("user.name", git_config_value(root, "user.name")),
        ("user.email", git_config_value(root, "user.email")),
    ]

    entries = [
        (key, value)
        for key, value in entries
        if value is not None
    ]

    if not entries:
        return []

    variables = [f"GIT_CONFIG_COUNT={len(entries)}"]

    for index, (key, value) in enumerate(entries):
        variables.append(f"GIT_CONFIG_KEY_{index}={key}")
        variables.append(f"GIT_CONFIG_VALUE_{index}={value}")

    arguments: list[str] = []

    for variable in variables:
        arguments.extend(["--env", variable])

    return arguments


def create_recovery_snapshot(root: Path) -> Path:
    """
    Save recoverable host-side Git state outside the mounted workspace.

    The container cannot access or delete this snapshot. Ignored files are
    intentionally excluded.
    """

    timestamp = datetime.now(timezone.utc).strftime(
        "%Y%m%dT%H%M%SZ"
    )

    base_destination = (
        state_root(root)
        / "snapshots"
        / timestamp
    )

    destination = base_destination
    suffix = 1

    while destination.exists():
        destination = Path(f"{base_destination}-{suffix}")
        suffix += 1

    destination.mkdir(parents=True, exist_ok=False)

    head = git_output(
        root,
        ["rev-parse", "HEAD"],
    ).strip()

    (destination / "head.txt").write_text(
        head + "\n",
        encoding="utf-8",
    )

    status = git_output(
        root,
        [
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
        ],
    )

    (destination / "status.txt").write_text(
        status,
        encoding="utf-8",
    )

    working_tree_diff = git_output(
        root,
        [
            "diff",
            "--binary",
            "HEAD",
        ],
    )

    (destination / "working-tree.patch").write_text(
        working_tree_diff,
        encoding="utf-8",
    )

    untracked_result = run(
        [
            "git",
            "ls-files",
            "--others",
            "--exclude-standard",
            "-z",
        ],
        cwd=root,
        capture=True,
    )

    untracked_paths = [
        Path(item)
        for item in untracked_result.stdout.split("\0")
        if item
    ]

    if untracked_paths:
        archive_path = destination / "untracked.tar.gz"

        with tarfile.open(archive_path, "w:gz") as archive:
            for relative_path in untracked_paths:
                absolute_path = root / relative_path

                # Files may disappear between Git enumeration and archiving.
                if (
                    absolute_path.exists()
                    or absolute_path.is_symlink()
                ):
                    archive.add(
                        absolute_path,
                        arcname=relative_path,
                        recursive=True,
                    )

    print(f"Recovery snapshot: {destination}")

    return destination


def global_config_entries(source: Path) -> list[str]:
    """
    Entries of ~/.config/opencode to expose in the box.

    Every subdirectory is included, so global agents, skills, plugins,
    commands, and themes work without agentbox knowing OpenCode's directory
    names.
    """

    if not source.is_dir():
        return []

    return [
        entry.name
        for entry in sorted(source.iterdir())
        if entry.name not in GLOBAL_CONFIG_EXCLUDED
        and (entry.is_dir() or entry.name in GLOBAL_CONFIG_FILES)
    ]


def container_entrypoint(
    container_command: list[str],
    *,
    config_entries: list[str] | None = None,
) -> list[str]:
    """
    Wrap the container command so shared OpenCode files are linked into place.

    A wrapper rather than an image ENTRYPOINT, because projects may supply
    their own Containerfile.dev and those images would not carry one.

    OpenCode may replace a symlink with a real file if it writes atomically, so
    a login or model choice made in one box is copied back into the shared
    volume on the next start instead of being stranded.
    """

    lines: list[str] = []

    for directory, filename in SHARED_LINKS:
        local = f"{directory}/{filename}"
        shared = f"{SHARED_PATH}/{filename}"

        lines.extend(
            [
                f'mkdir -p "{directory}"',
                f'if [ -f "{local}" ] && [ ! -L "{local}" ]; then',
                f'  cp -f "{local}" "{shared}"',
                "fi",
                f'ln -sfn "{shared}" "{local}"',
            ]
        )

    if config_entries:
        lines.append(f'mkdir -p "{GLOBAL_CONFIG_PATH}"')

        for name in config_entries:
            lines.append(
                f'ln -sfn "{GLOBAL_CONFIG_MOUNT}/{name}" '
                f'"{GLOBAL_CONFIG_PATH}/{name}"'
            )

    lines.append(f"exec {shlex.join(container_command)}")

    return ["bash", "-lc", "\n".join(lines) + "\n"]


def podman_run_command(
    root: Path,
    container_command: list[str],
    *,
    kind: str,
    session: str,
    network: str,
    home: Path | None = None,
) -> list[str]:
    uid = os.getuid()
    gid = os.getgid()

    home = home or Path.home()
    runtime_dir = f"/run/user/{uid}"
    agents_dir = home / ".agents"

    command = [
        "podman",
        "run",
        "--rm",
        "--interactive",
        "--tty",
        "--init",
        "--label",
        f"{PROJECT_PATH_LABEL}={root}",
        "--name",
        container_name(root, kind, session),
        "--hostname",
        f"agentbox-{root.name}",
        "--userns",
        "keep-id",
        "--user",
        f"{uid}:{gid}",
        "--read-only",
        "--cap-drop",
        "all",
        "--security-opt",
        "no-new-privileges",
        # "--memory",
        # os.environ.get("AGENTBOX_MEMORY", "12g"),
        "--cpus",
        os.environ.get("AGENTBOX_CPUS", "8"),
        "--network",
        network,
        "--tmpfs",
        "/tmp:rw,nosuid,nodev,size=2g,mode=1777",
        "--tmpfs",
        f"{runtime_dir}:rw,nosuid,nodev,size=64m,mode=0700",
        "--volume",
        f"{root}:{WORKSPACE_PATH}:rw,Z",
        "--volume",
        f"{home_volume_name(root)}:{AGENT_HOME}:rw,U",
        "--env",
        f"XDG_RUNTIME_DIR={runtime_dir}",
    ]

    for volume, destination in SHARED_VOLUME_MOUNTS:
        command.extend(
            [
                "--volume",
                f"{volume}:{destination}:rw,U",
            ]
        )

    command.extend(git_identity_env(root))

    # Host directories are read by every box at once, so they take the shared
    # SELinux label. The private label would let each new container revoke the
    # others' access.
    if agents_dir.is_dir():
        command.extend(
            [
                "--volume",
                f"{agents_dir}:{AGENT_HOME}/.agents:ro,z",
            ]
        )

    config_source = home / ".config" / "opencode"
    config_entries = global_config_entries(config_source)

    if config_entries:
        command.extend(
            [
                "--volume",
                f"{config_source}:{GLOBAL_CONFIG_MOUNT}:ro,z",
            ]
        )

    command.append(image_name(root))
    command.extend(
        container_entrypoint(
            container_command,
            config_entries=config_entries,
        )
    )

    return command


def volume_exists(name: str) -> bool:
    result = run(
        ["podman", "volume", "exists", name],
        check=False,
    )

    return result.returncode == 0


def ensure_volume(
    name: str,
    *,
    labels: dict[str, str] | None = None,
) -> None:
    """
    Create a volume up front so it carries labels.

    Volumes created implicitly by `podman run` have none, which leaves them
    unattributable during a clean sweep.
    """

    if volume_exists(name):
        return

    command = ["podman", "volume", "create"]

    for key, value in (labels or {}).items():
        command.extend(["--label", f"{key}={value}"])

    command.append(name)

    run(command, capture=True)


def ensure_volumes(root: Path) -> None:
    ensure_volume(
        home_volume_name(root),
        labels={PROJECT_PATH_LABEL: str(root)},
    )

    for name in SHARED_VOLUMES:
        ensure_volume(name)


def start_container(
    root: Path,
    container_command: list[str],
    *,
    kind: str,
    session: str,
    network: str = "slirp4netns",
) -> None:
    ensure_volumes(root)

    command = podman_run_command(
        root,
        container_command,
        kind=kind,
        session=session,
        network=network,
    )

    run(command, cwd=root)


def command_run(
    args: argparse.Namespace,
    root: Path,
) -> None:
    ensure_image(
        root,
        rebuild=args.rebuild,
    )

    if not args.no_snapshot:
        create_recovery_snapshot(root)

    opencode_command = [
        "opencode",
        "--auto",
        WORKSPACE_PATH,
    ]

    opencode_command.extend(args.opencode_args)

    start_container(
        root,
        opencode_command,
        kind="opencode",
        session=args.name or session_suffix(),
        network=args.network,
    )


def command_shell(
    args: argparse.Namespace,
    root: Path,
) -> None:
    ensure_image(
        root,
        rebuild=args.rebuild,
    )

    if not args.no_snapshot:
        create_recovery_snapshot(root)

    start_container(
        root,
        ["bash", "-l"],
        kind="shell",
        session=args.name or session_suffix(),
        network=args.network,
    )


def command_auth(
    args: argparse.Namespace,
    root: Path,
) -> None:
    ensure_image(
        root,
        rebuild=args.rebuild,
    )

    start_container(
        root,
        [
            "opencode",
            "auth",
            "login",
        ],
        kind="auth",
        session=args.name or session_suffix(),
        network=args.network,
    )


def command_build(
    args: argparse.Namespace,
    root: Path,
) -> None:
    if containerfile_path(root) is None:
        pull_default_image(refresh=args.no_cache)
        return

    build_image(
        root,
        no_cache=args.no_cache,
    )


def command_status(
    _args: argparse.Namespace,
    root: Path,
) -> None:
    prefix = f"agentbox-{project_key(root)}"

    result = run(
        [
            "podman",
            "ps",
            "--all",
            "--filter",
            f"name={prefix}",
            "--format",
            "table {{.Names}}\t{{.Status}}\t{{.Image}}",
        ],
        capture=True,
        check=False,
    )

    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout, end="")
    else:
        print(f"No containers for this project: {prefix}")


def load_entries(payload: str) -> list[dict]:
    try:
        entries = json.loads(payload)
    except json.JSONDecodeError:
        return []

    if not isinstance(entries, list):
        return []

    return [entry for entry in entries if isinstance(entry, dict)]


def entry_label(entry: dict, label: str) -> str | None:
    labels = entry.get("Labels") or entry.get("labels") or {}

    if not isinstance(labels, dict):
        return None

    value = labels.get(label)

    return value or None


def parse_container_entries(payload: str) -> list[Resource]:
    resources: list[Resource] = []

    for entry in load_entries(payload):
        names = entry.get("Names") or entry.get("names") or []

        for name in names:
            if not name.startswith(RESOURCE_PREFIX):
                continue

            resources.append(
                Resource(
                    kind="container",
                    name=name,
                    identifier=name,
                    project_path=entry_label(entry, PROJECT_PATH_LABEL),
                )
            )

    return resources


def parse_volume_entries(payload: str) -> list[Resource]:
    resources: list[Resource] = []

    for entry in load_entries(payload):
        name = entry.get("Name") or entry.get("name")

        if not name or not name.startswith(RESOURCE_PREFIX):
            continue

        resources.append(
            Resource(
                kind="volume",
                name=name,
                identifier=name,
                project_path=entry_label(entry, PROJECT_PATH_LABEL),
                shared=name in SHARED_VOLUMES,
            )
        )

    return resources


def parse_image_entries(payload: str) -> list[Resource]:
    resources: list[Resource] = []

    # An image with several tags is listed once per tag.
    seen: set[str] = set()

    for entry in load_entries(payload):
        names = (
            entry.get("Names")
            or entry.get("names")
            or entry.get("RepoTags")
            or entry.get("repoTags")
            or []
        )

        match = next(
            (name for name in names if name.startswith(IMAGE_PREFIX)),
            None,
        )

        if match is None:
            continue

        image_id = (
            entry.get("Id")
            or entry.get("ID")
            or entry.get("id")
        )

        if not image_id or image_id in seen:
            continue

        seen.add(image_id)

        resources.append(
            Resource(
                kind="image",
                name=match,
                identifier=image_id,
                project_path=entry_label(entry, PROJECT_PATH_LABEL),
            )
        )

    return resources


def classify_resources(
    resources: list[Resource],
    *,
    directory_exists: Callable[[str], bool],
) -> dict[str, list[Resource]]:
    """
    Sort resources by whether the project they belong to still exists.

    Shared volumes and resources created before project-path labels existed
    cannot be attributed to a project, so they are reported as unknown and
    only removed by --all.
    """

    groups: dict[str, list[Resource]] = {
        "live": [],
        "dangling": [],
        "unknown": [],
    }

    for resource in resources:
        if resource.shared or resource.project_path is None:
            groups["unknown"].append(resource)
        elif directory_exists(resource.project_path):
            groups["live"].append(resource)
        else:
            groups["dangling"].append(resource)

    return groups


def select_for_removal(
    groups: dict[str, list[Resource]],
    *,
    all_resources: bool,
) -> list[Resource]:
    if all_resources:
        return [
            resource
            for key in ("live", "dangling", "unknown")
            for resource in groups.get(key, [])
        ]

    return list(groups.get("dangling", []))


def podman_json(command: list[str]) -> str:
    result = run(command, capture=True, check=False)

    if result.returncode != 0:
        return ""

    return result.stdout


def discover_resources() -> list[Resource]:
    containers = parse_container_entries(
        podman_json(
            ["podman", "ps", "--all", "--format", "json"]
        )
    )

    volumes = parse_volume_entries(
        podman_json(
            ["podman", "volume", "ls", "--format", "json"]
        )
    )

    images = parse_image_entries(
        podman_json(
            ["podman", "images", "--all", "--format", "json"]
        )
    )

    return [*containers, *volumes, *images]


def project_containers(root: Path) -> list[str]:
    prefix = f"{RESOURCE_PREFIX}{project_key(root)}"

    return [
        resource.name
        for resource in parse_container_entries(
            podman_json(
                ["podman", "ps", "--all", "--format", "json"]
            )
        )
        if resource.name.startswith(prefix)
    ]


def project_images(root: Path) -> list[str]:
    prefix = f"{IMAGE_PREFIX}{project_key(root)}"

    identifiers: list[str] = []

    for resource in parse_image_entries(
        podman_json(
            ["podman", "images", "--all", "--format", "json"]
        )
    ):
        if not resource.name.startswith(prefix):
            continue

        if resource.identifier not in identifiers:
            identifiers.append(resource.identifier)

    return identifiers


def confirm(prompt: str, *, assume_yes: bool) -> bool:
    if assume_yes:
        return True

    answer = input(f"{prompt} [y/N] ").strip().lower()

    if answer in ("y", "yes"):
        return True

    print("Aborted.")

    return False


REMOVE_COMMANDS = {
    "container": ["podman", "rm", "--force"],
    "volume": ["podman", "volume", "rm", "--force"],
    "image": ["podman", "image", "rm", "--force"],
}


def remove_resources(resources: list[Resource]) -> None:
    # Containers first: a volume or image still in use cannot be removed.
    order = {"container": 0, "volume": 1, "image": 2}

    for resource in sorted(resources, key=lambda item: order[item.kind]):
        run(
            [*REMOVE_COMMANDS[resource.kind], resource.identifier],
            capture=True,
            check=False,
        )


def describe_resources(resources: list[Resource]) -> None:
    for kind in ("container", "volume", "image"):
        names = [
            resource.name
            for resource in resources
            if resource.kind == kind
        ]

        if names:
            print(f"  {len(names)} {kind}(s): " + ", ".join(names))


def clean_project(root: Path, *, assume_yes: bool) -> None:
    containers = project_containers(root)
    images = project_images(root)
    volume = home_volume_name(root)

    resources = [
        Resource(
            kind="container",
            name=name,
            identifier=name,
            project_path=str(root),
        )
        for name in containers
    ]

    if volume_exists(volume):
        resources.append(
            Resource(
                kind="volume",
                name=volume,
                identifier=volume,
                project_path=str(root),
            )
        )

    resources.extend(
        Resource(
            kind="image",
            name=identifier,
            identifier=identifier,
            project_path=str(root),
        )
        for identifier in images
    )

    if not resources:
        print("Nothing to clean for this project.")
        return

    print("Will remove:")
    describe_resources(resources)

    if not confirm("Continue?", assume_yes=assume_yes):
        return

    remove_resources(resources)

    print(
        "Removed project containers, images, "
        "and persistent agent home."
    )


def clean_sweep(*, all_resources: bool, assume_yes: bool) -> None:
    groups = classify_resources(
        discover_resources(),
        directory_exists=lambda path: Path(path).is_dir(),
    )

    selected = select_for_removal(groups, all_resources=all_resources)

    if not selected:
        if all_resources:
            print("No agentbox resources found.")
        else:
            print("No dangling agentbox resources found.")
            report_unknown(groups)

        return

    if all_resources:
        print("Will remove every agentbox resource:")
    else:
        print("Will remove resources for deleted directories:")

    describe_resources(selected)

    if all_resources and any(
        resource.shared for resource in selected
    ):
        print(
            "  (this includes the shared OpenCode login; "
            "you will need to run 'agentbox auth' again)"
        )

    if not confirm("Continue?", assume_yes=assume_yes):
        return

    remove_resources(selected)

    print(f"Removed {len(selected)} resource(s).")

    if not all_resources:
        report_unknown(groups)


def report_unknown(groups: dict[str, list[Resource]]) -> None:
    unlabeled = [
        resource
        for resource in groups.get("unknown", [])
        if not resource.shared
    ]

    if unlabeled:
        print(
            f"{len(unlabeled)} resource(s) predate project tracking "
            "and cannot be attributed; use --all to remove them."
        )


def command_clean(args: argparse.Namespace) -> None:
    if args.project_only:
        root = find_project_root(
            args.project.expanduser().resolve()
        )

        clean_project(root, assume_yes=args.yes)
        return

    clean_sweep(all_resources=args.all, assume_yes=args.yes)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentbox",
        description=(
            "Run a repository coding agent inside "
            "a rootless Podman sandbox."
        ),
    )

    parser.add_argument(
        "--project",
        type=Path,
        default=Path.cwd(),
        help=(
            "Path inside the project. "
            "Defaults to the current directory."
        ),
    )

    subparsers = parser.add_subparsers(
        dest="command",
    )

    common = argparse.ArgumentParser(
        add_help=False,
    )

    common.add_argument(
        "--rebuild",
        action="store_true",
        help="Force an image build before starting.",
    )

    common.add_argument(
        "--no-snapshot",
        action="store_true",
        help=(
            "Do not save a pre-session Git "
            "recovery snapshot."
        ),
    )

    common.add_argument(
        "--name",
        type=validate_session_name,
        help=(
            "Session name for the container. "
            "Defaults to a unique value; use it to "
            "start multiple containers side by side."
        ),
    )

    common.add_argument(
        "--network",
        default="slirp4netns",
        help=(
            "Podman network mode. "
            "Defaults to slirp4netns."
        ),
    )

    run_parser = subparsers.add_parser(
        "run",
        parents=[common],
        help="Start OpenCode.",
    )

    run_parser.add_argument(
        "opencode_args",
        nargs=argparse.REMAINDER,
        help=(
            "Arguments after '--' are passed "
            "directly to OpenCode."
        ),
    )

    subparsers.add_parser(
        "shell",
        parents=[common],
        help="Open a shell in the development container.",
    )

    auth_parser = subparsers.add_parser(
        "auth",
        parents=[common],
        help=(
            "Authenticate OpenCode in the "
            "persistent project home."
        ),
    )

    auth_parser.set_defaults(
        no_snapshot=True,
    )

    build_subparser = subparsers.add_parser(
        "build",
        help="Build the development image.",
    )

    build_subparser.add_argument(
        "--no-cache",
        action="store_true",
        help=(
            "Disable the build cache and refresh "
            "the base image."
        ),
    )

    subparsers.add_parser(
        "status",
        help=(
            "List the project's containers "
            "and their status."
        ),
    )

    clean_parser = subparsers.add_parser(
        "clean",
        help=(
            "Delete containers, images, and agent homes "
            "left behind by deleted directories."
        ),
    )

    clean_scope = clean_parser.add_mutually_exclusive_group()

    clean_scope.add_argument(
        "--all",
        action="store_true",
        help=(
            "Remove every agentbox resource, including "
            "live projects and the shared OpenCode login."
        ),
    )

    clean_scope.add_argument(
        "--project",
        dest="project_only",
        action="store_true",
        help=(
            "Remove only this project's containers, "
            "image, and persistent agent home."
        ),
    )

    clean_parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help=(
            "Remove without prompting for "
            "confirmation."
        ),
    )

    return parser


def apply_default_run_arguments(
    args: argparse.Namespace,
) -> None:
    args.command = "run"
    args.rebuild = False
    args.no_snapshot = False
    args.name = None
    args.network = "slirp4netns"
    args.opencode_args = []


def main() -> int:
    try:
        require_command("git")
        require_command("podman")

        parser = build_parser()
        args = parser.parse_args()

        if args.command is None:
            apply_default_run_arguments(args)

        # `clean` sweeps across projects, so it must run from anywhere. Every
        # other command needs a project root.
        if args.command == "clean":
            command_clean(args)
            return 0

        root = find_project_root(
            args.project.expanduser().resolve()
        )

        if args.command == "run":
            command_run(args, root)
        elif args.command == "shell":
            command_shell(args, root)
        elif args.command == "auth":
            command_auth(args, root)
        elif args.command == "build":
            command_build(args, root)
        elif args.command == "status":
            command_status(args, root)
        else:
            parser.error(
                f"Unknown command: {args.command}"
            )

        return 0

    except AgentboxError as error:
        print(
            f"agentbox: {error}",
            file=sys.stderr,
        )
        return 1

    except subprocess.CalledProcessError as error:
        print(
            (
                "agentbox: command failed with "
                f"exit code {error.returncode}"
            ),
            file=sys.stderr,
        )
        return error.returncode

    except KeyboardInterrupt:
        print(
            "\nagentbox: interrupted",
            file=sys.stderr,
        )
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
