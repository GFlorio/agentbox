#!/usr/bin/env python3

from __future__ import annotations

import argparse
from collections.abc import Callable
from dataclasses import dataclass
from datetime import datetime, timezone
import hashlib
import json
import os
from pathlib import Path
import re
import secrets
import shlex
import shutil
import subprocess
import sys
import tarfile


CONTAINERFILE = "Containerfile.dev"
DEFAULT_IMAGE = os.environ.get(
    "AGENTBOX_DEFAULT_IMAGE", "ghcr.io/gflorio/agentbox:latest"
)
WORKSPACE_PATH = "/workspace"
AGENT_HOME = "/home/agent"
IMAGE_HASH_LABEL = "dev.agentbox.containerfile-sha256"
PROJECT_PATH_LABEL = "dev.agentbox.project-path"

RESOURCE_PREFIX = "agentbox-"
IMAGE_PREFIX = "localhost/agentbox-"

# OpenCode keeps credentials in its data directory and the selected model in
# its state directory. Both files live in one volume shared by every project so
# that a single `agentbox auth` and model choice cover all worktrees.
SHARED_VOLUME = "agentbox-shared"

OPENCODE_DATA_PATH = f"{AGENT_HOME}/.local/share/opencode"
OPENCODE_STATE_PATH = f"{AGENT_HOME}/.local/state/opencode"

# Mounted one level below the agent home, and never deeper. Podman creates
# missing intermediate mountpoints as root inside the home volume, and those
# directories are not overlaid by anything, so their parents become unwritable
# by the agent. A single-level mountpoint is the volume itself, which the U
# flag chowns to the agent.
#
# Individual files are linked out of it rather than mounting over the OpenCode
# directories, which would also share opencode.db and make session history
# common to every worktree.
SHARED_PATH = f"{AGENT_HOME}/.agentbox-shared"

SHARED_LINKS = (
    (OPENCODE_DATA_PATH, "auth.json"),
    (OPENCODE_STATE_PATH, "model.json"),
)

GLOBAL_CONFIG_PATH = f"{AGENT_HOME}/.config/opencode"

# The host config directory is mounted whole, one level below the agent home
# for the reason given above, and its entries are linked into the path OpenCode
# reads. opencode.jsonc is present here but never linked.
GLOBAL_CONFIG_MOUNT = f"{AGENT_HOME}/.agentbox-config"

# The box ships its own opencode.json; the host copy must not override it.
GLOBAL_CONFIG_EXCLUDED = frozenset({"opencode.jsonc"})

# Kept alongside the mounted subdirectories because it is OpenCode's manifest
# of npm-installed global plugins.
GLOBAL_CONFIG_FILES = frozenset({"package.json"})

SESSION_NAME_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]*\Z")


class AgentboxError(RuntimeError):
    """Expected agentbox failure with a user-facing error message."""


@dataclass(frozen=True)
class Resource:
    """A podman container, volume, or image created by agentbox."""

    kind: str
    name: str
    identifier: str
    project_path: str | None
    shared: bool = False


def run(
    command: list[str],
    *,
    cwd: Path | None = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        command,
        cwd=cwd,
        check=check,
        text=True,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if capture else None,
    )


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        raise AgentboxError(f"Required command not found: {name}")


def find_project_root(start: Path) -> Path:
    result = run(
        ["git", "rev-parse", "--show-toplevel"],
        cwd=start,
        capture=True,
        check=False,
    )

    if result.returncode != 0:
        raise AgentboxError(f"Not inside a Git working tree: {start}")

    return Path(result.stdout.strip()).resolve()


def project_key(root: Path) -> str:
    digest = hashlib.sha256(str(root).encode("utf-8")).hexdigest()[:10]

    safe_name = "".join(
        character if character.isalnum() else "-"
        for character in root.name.lower()
    ).strip("-")

    return f"{safe_name}-{digest}"


def containerfile_path(root: Path) -> Path | None:
    path = root / CONTAINERFILE
    return path if path.is_file() else None


def image_name(root: Path) -> str:
    if containerfile_path(root) is None:
        return DEFAULT_IMAGE

    return f"{IMAGE_PREFIX}{project_key(root)}:dev"


def home_volume_name(root: Path) -> str:
    return f"{RESOURCE_PREFIX}{project_key(root)}-home"


def container_name(root: Path, kind: str, session: str) -> str:
    return f"{RESOURCE_PREFIX}{project_key(root)}-{kind}-{session}"


def state_root(root: Path) -> Path:
    xdg_state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    )

    return xdg_state_home / "agentbox" / project_key(root)


def containerfile_hash(root: Path) -> str:
    return hashlib.sha256((root / CONTAINERFILE).read_bytes()).hexdigest()


def image_exists(name: str) -> bool:
    return run(["podman", "image", "exists", name], check=False).returncode == 0


def image_containerfile_hash(name: str) -> str | None:
    result = run(
        [
            "podman", "image", "inspect", name,
            "--format", f'{{{{ index .Labels "{IMAGE_HASH_LABEL}" }}}}',
        ],
        capture=True,
        check=False,
    )

    if result.returncode != 0:
        return None

    # podman prints this placeholder when the label is absent.
    value = result.stdout.strip()

    return None if value in ("", "<no value>") else value


def build_image(root: Path, *, no_cache: bool = False) -> None:
    containerfile = containerfile_path(root)

    if containerfile is None:
        raise AgentboxError(f"{root} does not contain {CONTAINERFILE}")

    command = [
        "podman", "build",
        "--tag", image_name(root),
        "--label", f"{IMAGE_HASH_LABEL}={containerfile_hash(root)}",
        "--label", f"{PROJECT_PATH_LABEL}={root}",
        "--build-arg", f"USER_ID={os.getuid()}",
        "--build-arg", f"GROUP_ID={os.getgid()}",
        "--file", str(containerfile),
    ]

    if no_cache:
        command.extend(["--no-cache", "--pull=always"])

    command.append(str(root))

    print(f"Building {image_name(root)}...")

    # Output is held back and printed only on failure, so a successful start
    # is not buried under build logs.
    result = subprocess.run(
        command,
        cwd=root,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    if result.returncode != 0:
        print(result.stdout, file=sys.stderr, end="")

        raise subprocess.CalledProcessError(
            result.returncode, command, output=result.stdout
        )

    print("Development image ready.")


def pull_default_image(*, refresh: bool = False) -> None:
    if not refresh and image_exists(DEFAULT_IMAGE):
        return

    print(f"Pulling {DEFAULT_IMAGE}...")
    run(["podman", "pull", DEFAULT_IMAGE])


def ensure_image(root: Path, *, rebuild: bool = False) -> None:
    if containerfile_path(root) is None:
        pull_default_image(refresh=rebuild)
        return

    name = image_name(root)

    if rebuild or not image_exists(name):
        build_image(root)
        return

    if image_containerfile_hash(name) != containerfile_hash(root):
        print(f"{CONTAINERFILE} changed; rebuilding development image.")
        build_image(root)


def session_suffix() -> str:
    timestamp = datetime.now(timezone.utc).strftime("%y%m%d%H%M%S")

    return f"{timestamp}-{secrets.token_hex(3)}"


def validate_session_name(value: str) -> str:
    if not SESSION_NAME_PATTERN.match(value):
        raise AgentboxError(
            "--name must start with a letter or digit and "
            "contain only letters, digits, '.', '_' or '-'"
        )

    return value


def git_output(root: Path, arguments: list[str]) -> str:
    return run(["git", *arguments], cwd=root, capture=True).stdout


def git_config_value(root: Path, key: str) -> str | None:
    result = run(
        ["git", "config", "--get", key], cwd=root, capture=True, check=False
    )

    if result.returncode != 0:
        return None

    return result.stdout.strip() or None


def git_identity_env(root: Path) -> list[str]:
    """
    Expose the host Git identity to the container.

    GIT_CONFIG_* entries are read by `git config --get` too, so the agent
    sees the same user.name and user.email the host does.
    """

    entries = [
        (key, value)
        for key in ("user.name", "user.email")
        if (value := git_config_value(root, key)) is not None
    ]

    if not entries:
        return []

    arguments = ["--env", f"GIT_CONFIG_COUNT={len(entries)}"]

    for index, (key, value) in enumerate(entries):
        arguments.extend(["--env", f"GIT_CONFIG_KEY_{index}={key}"])
        arguments.extend(["--env", f"GIT_CONFIG_VALUE_{index}={value}"])

    return arguments


def create_recovery_snapshot(root: Path) -> Path:
    """
    Save recoverable host-side Git state outside the mounted workspace.

    The container cannot access or delete this snapshot. Ignored files are
    intentionally excluded.
    """

    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    destination = state_root(root) / "snapshots" / f"{stamp}-{secrets.token_hex(3)}"
    destination.mkdir(parents=True, exist_ok=False)

    head = git_output(root, ["rev-parse", "HEAD"]).strip()
    (destination / "head.txt").write_text(head + "\n", encoding="utf-8")

    status = git_output(
        root, ["status", "--porcelain=v1", "--untracked-files=all"]
    )
    (destination / "status.txt").write_text(status, encoding="utf-8")

    diff = git_output(root, ["diff", "--binary", "HEAD"])
    (destination / "working-tree.patch").write_text(diff, encoding="utf-8")

    listing = git_output(
        root, ["ls-files", "--others", "--exclude-standard", "-z"]
    )
    untracked = [item for item in listing.split("\0") if item]

    if untracked:
        with tarfile.open(destination / "untracked.tar.gz", "w:gz") as archive:
            for relative in untracked:
                # Files may disappear between Git enumeration and archiving.
                if os.path.lexists(root / relative):
                    archive.add(root / relative, arcname=relative)

    print(f"Recovery snapshot: {destination}")

    return destination


def global_config_entries(source: Path) -> list[str]:
    """
    Entries of ~/.config/opencode to expose in the box.

    Every subdirectory is included, so global agents, skills, plugins,
    commands, and themes work without agentbox knowing OpenCode's directory
    names.
    """

    if not source.is_dir():
        return []

    return [
        entry.name
        for entry in sorted(source.iterdir())
        if entry.name not in GLOBAL_CONFIG_EXCLUDED
        and (entry.is_dir() or entry.name in GLOBAL_CONFIG_FILES)
    ]


def container_entrypoint(
    container_command: list[str],
    *,
    config_entries: list[str] | None = None,
) -> list[str]:
    """
    Wrap the container command so shared OpenCode files are linked into place.

    A wrapper rather than an image ENTRYPOINT, because projects may supply
    their own Containerfile.dev and those images would not carry one.

    OpenCode may replace a symlink with a real file if it writes atomically, so
    a login or model choice made in one box is copied back into the shared
    volume on the next start instead of being stranded.
    """

    lines: list[str] = []

    for directory, filename in SHARED_LINKS:
        local = f"{directory}/{filename}"
        shared = f"{SHARED_PATH}/{filename}"

        lines.extend(
            [
                f'mkdir -p "{directory}"',
                f'if [ -f "{local}" ] && [ ! -L "{local}" ]; then',
                f'  cp -f "{local}" "{shared}"',
                "fi",
                f'ln -sfn "{shared}" "{local}"',
            ]
        )

    if config_entries:
        lines.append(f'mkdir -p "{GLOBAL_CONFIG_PATH}"')

        lines.extend(
            f'ln -sfn "{GLOBAL_CONFIG_MOUNT}/{name}" '
            f'"{GLOBAL_CONFIG_PATH}/{name}"'
            for name in config_entries
        )

    lines.append(f"exec {shlex.join(container_command)}")

    return ["bash", "-lc", "\n".join(lines) + "\n"]


def podman_run_command(
    root: Path,
    container_command: list[str],
    *,
    kind: str,
    session: str,
    network: str,
    home: Path | None = None,
) -> list[str]:
    uid = os.getuid()
    gid = os.getgid()

    home = home or Path.home()
    runtime_dir = f"/run/user/{uid}"

    command = [
        "podman", "run",
        "--rm", "--interactive", "--tty", "--init",
        "--label", f"{PROJECT_PATH_LABEL}={root}",
        "--name", container_name(root, kind, session),
        "--hostname", f"agentbox-{root.name}",
        "--userns", "keep-id",
        "--user", f"{uid}:{gid}",
        "--read-only",
        "--cap-drop", "all",
        "--security-opt", "no-new-privileges",
        "--cpus", os.environ.get("AGENTBOX_CPUS", "8"),
        "--network", network,
        "--tmpfs", "/tmp:rw,nosuid,nodev,size=2g,mode=1777",
        "--tmpfs", f"{runtime_dir}:rw,nosuid,nodev,size=64m,mode=0700",
        "--volume", f"{root}:{WORKSPACE_PATH}:rw,Z",
        "--volume", f"{home_volume_name(root)}:{AGENT_HOME}:rw,U",
        "--volume", f"{SHARED_VOLUME}:{SHARED_PATH}:rw,U",
        "--env", f"XDG_RUNTIME_DIR={runtime_dir}",
    ]

    command.extend(git_identity_env(root))

    # Host directories are read by every box at once, so they take the shared
    # SELinux label. The private label would let each new container revoke the
    # others' access.
    agents_dir = home / ".agents"

    if agents_dir.is_dir():
        command.extend(
            ["--volume", f"{agents_dir}:{AGENT_HOME}/.agents:ro,z"]
        )

    config_source = home / ".config" / "opencode"
    config_entries = global_config_entries(config_source)

    if config_entries:
        command.extend(
            ["--volume", f"{config_source}:{GLOBAL_CONFIG_MOUNT}:ro,z"]
        )

    command.append(image_name(root))
    command.extend(
        container_entrypoint(container_command, config_entries=config_entries)
    )

    return command


def volume_exists(name: str) -> bool:
    return (
        run(["podman", "volume", "exists", name], check=False).returncode == 0
    )


def ensure_volume(name: str, *, project_path: Path | None = None) -> None:
    """
    Create a volume up front so it carries its project label.

    Volumes created implicitly by `podman run` have none, which leaves them
    unattributable during a clean sweep.
    """

    if volume_exists(name):
        return

    command = ["podman", "volume", "create"]

    if project_path is not None:
        command.extend(["--label", f"{PROJECT_PATH_LABEL}={project_path}"])

    command.append(name)

    run(command, capture=True)


def start_container(
    root: Path,
    container_command: list[str],
    *,
    kind: str,
    session: str,
    network: str,
) -> None:
    ensure_volume(home_volume_name(root), project_path=root)
    ensure_volume(SHARED_VOLUME)

    run(
        podman_run_command(
            root,
            container_command,
            kind=kind,
            session=session,
            network=network,
        ),
        cwd=root,
    )


def command_session(args: argparse.Namespace, root: Path) -> None:
    """Start a container for `run`, `shell`, or `auth`."""

    ensure_image(root, rebuild=args.rebuild)

    if args.snapshot and not args.no_snapshot:
        create_recovery_snapshot(root)

    start_container(
        root,
        [*args.container_command, *args.opencode_args],
        kind=args.kind,
        session=args.name or session_suffix(),
        network=args.network,
    )


def command_build(args: argparse.Namespace, root: Path) -> None:
    if containerfile_path(root) is None:
        pull_default_image(refresh=args.no_cache)
        return

    build_image(root, no_cache=args.no_cache)


def command_status(_args: argparse.Namespace, root: Path) -> None:
    prefix = f"{RESOURCE_PREFIX}{project_key(root)}"

    result = run(
        [
            "podman", "ps", "--all",
            "--filter", f"name={prefix}",
            "--format", "table {{.Names}}\t{{.Status}}\t{{.Image}}",
        ],
        capture=True,
        check=False,
    )

    if result.returncode == 0 and result.stdout.strip():
        print(result.stdout, end="")
    else:
        print(f"No containers for this project: {prefix}")


def podman_json(command: list[str]) -> list[dict]:
    """Run a `--format json` podman listing and return its entries."""

    result = run(command, capture=True, check=False)

    if result.returncode != 0:
        return []

    return json.loads(result.stdout or "[]") or []


def entry_label(entry: dict, label: str) -> str | None:
    return (entry.get("Labels") or {}).get(label) or None


def parse_container_entries(entries: list[dict]) -> list[Resource]:
    return [
        Resource(
            kind="container",
            name=name,
            identifier=name,
            project_path=entry_label(entry, PROJECT_PATH_LABEL),
        )
        for entry in entries
        for name in entry.get("Names") or []
        if name.startswith(RESOURCE_PREFIX)
    ]


def parse_volume_entries(entries: list[dict]) -> list[Resource]:
    return [
        Resource(
            kind="volume",
            name=entry["Name"],
            identifier=entry["Name"],
            project_path=entry_label(entry, PROJECT_PATH_LABEL),
            shared=entry["Name"] == SHARED_VOLUME,
        )
        for entry in entries
        if entry.get("Name", "").startswith(RESOURCE_PREFIX)
    ]


def parse_image_entries(entries: list[dict]) -> list[Resource]:
    resources: list[Resource] = []

    # An image with several tags is listed once per tag.
    seen: set[str] = set()

    for entry in entries:
        name = next(
            (
                name
                for name in entry.get("Names") or []
                if name.startswith(IMAGE_PREFIX)
            ),
            None,
        )

        if name is None or entry["Id"] in seen:
            continue

        seen.add(entry["Id"])

        resources.append(
            Resource(
                kind="image",
                name=name,
                identifier=entry["Id"],
                project_path=entry_label(entry, PROJECT_PATH_LABEL),
            )
        )

    return resources


def discover_resources() -> list[Resource]:
    return [
        *parse_container_entries(
            podman_json(["podman", "ps", "--all", "--format", "json"])
        ),
        *parse_volume_entries(
            podman_json(["podman", "volume", "ls", "--format", "json"])
        ),
        *parse_image_entries(
            podman_json(["podman", "images", "--all", "--format", "json"])
        ),
    ]


def project_resources(root: Path) -> list[Resource]:
    """Every resource belonging to one project. Shared state is never included."""

    marker = f"{RESOURCE_PREFIX}{project_key(root)}"

    return [
        resource
        for resource in discover_resources()
        if not resource.shared
        and (marker in resource.name or resource.project_path == str(root))
    ]


def select_for_removal(
    resources: list[Resource],
    *,
    all_resources: bool,
    directory_exists: Callable[[str], bool],
) -> list[Resource]:
    """
    Choose which resources a sweep removes.

    Shared volumes and resources without a project-path label cannot be
    attributed to a directory, so only --all removes them.
    """

    if all_resources:
        return list(resources)

    return [
        resource
        for resource in resources
        if not resource.shared
        and resource.project_path is not None
        and not directory_exists(resource.project_path)
    ]


def confirm(prompt: str, *, assume_yes: bool) -> bool:
    if assume_yes:
        return True

    if input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes"):
        return True

    print("Aborted.")

    return False


REMOVE_COMMANDS = {
    "container": ["podman", "rm", "--force"],
    "volume": ["podman", "volume", "rm", "--force"],
    "image": ["podman", "image", "rm", "--force"],
}

# Containers first: a volume or image still in use cannot be removed.
REMOVE_ORDER = list(REMOVE_COMMANDS)


def remove_resources(resources: list[Resource]) -> None:
    for resource in sorted(
        resources, key=lambda item: REMOVE_ORDER.index(item.kind)
    ):
        run(
            [*REMOVE_COMMANDS[resource.kind], resource.identifier],
            capture=True,
            check=False,
        )


def describe_resources(resources: list[Resource]) -> None:
    for kind in REMOVE_ORDER:
        names = [item.name for item in resources if item.kind == kind]

        if names:
            print(f"  {len(names)} {kind}(s): " + ", ".join(names))


def clean_project(root: Path, *, assume_yes: bool) -> None:
    resources = project_resources(root)

    if not resources:
        print("Nothing to clean for this project.")
        return

    print("Will remove:")
    describe_resources(resources)

    if not confirm("Continue?", assume_yes=assume_yes):
        return

    remove_resources(resources)

    print("Removed project containers, images, and persistent agent home.")


def clean_sweep(*, all_resources: bool, assume_yes: bool) -> None:
    selected = select_for_removal(
        discover_resources(),
        all_resources=all_resources,
        directory_exists=lambda path: Path(path).is_dir(),
    )

    if not selected:
        print(
            "No agentbox resources found."
            if all_resources
            else "No dangling agentbox resources found."
        )
        return

    print(
        "Will remove every agentbox resource:"
        if all_resources
        else "Will remove resources for deleted directories:"
    )

    describe_resources(selected)

    if any(resource.shared for resource in selected):
        print(
            "  (this includes the shared OpenCode login; "
            "you will need to run 'agentbox auth' again)"
        )

    if not confirm("Continue?", assume_yes=assume_yes):
        return

    remove_resources(selected)

    print(f"Removed {len(selected)} resource(s).")


def command_clean(args: argparse.Namespace) -> None:
    if args.project_only:
        root = find_project_root(args.project.expanduser().resolve())
        clean_project(root, assume_yes=args.yes)
        return

    clean_sweep(all_resources=args.all, assume_yes=args.yes)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="agentbox",
        description=(
            "Run a repository coding agent inside a rootless Podman sandbox."
        ),
    )

    parser.add_argument(
        "--project",
        type=Path,
        default=Path.cwd(),
        help="Path inside the project. Defaults to the current directory.",
    )

    # Only `run` accepts pass-through arguments; the others share the handler.
    parser.set_defaults(opencode_args=[])

    subparsers = parser.add_subparsers(dest="command")

    common = argparse.ArgumentParser(add_help=False)

    common.add_argument(
        "--rebuild",
        action="store_true",
        help="Force an image build before starting.",
    )

    common.add_argument(
        "--no-snapshot",
        action="store_true",
        help="Do not save a pre-session Git recovery snapshot.",
    )

    common.add_argument(
        "--name",
        type=validate_session_name,
        help=(
            "Session name for the container. Defaults to a unique value; "
            "use it to start multiple containers side by side."
        ),
    )

    common.add_argument(
        "--network",
        default="slirp4netns",
        help="Podman network mode. Defaults to slirp4netns.",
    )

    run_parser = subparsers.add_parser(
        "run", parents=[common], help="Start OpenCode."
    )

    run_parser.add_argument(
        "opencode_args",
        nargs=argparse.REMAINDER,
        help="Arguments after '--' are passed directly to OpenCode.",
    )

    run_parser.set_defaults(
        kind="opencode",
        container_command=["opencode", "--auto", WORKSPACE_PATH],
        snapshot=True,
    )

    shell_parser = subparsers.add_parser(
        "shell",
        parents=[common],
        help="Open a shell in the development container.",
    )

    shell_parser.set_defaults(
        kind="shell", container_command=["bash", "-l"], snapshot=True
    )

    auth_parser = subparsers.add_parser(
        "auth",
        parents=[common],
        help="Authenticate OpenCode in the persistent project home.",
    )

    auth_parser.set_defaults(
        kind="auth",
        container_command=["opencode", "auth", "login"],
        # A dest with no matching action, so this default stays local to
        # `auth`; setting `no_snapshot` here would mutate the shared
        # `--no-snapshot` action and disable snapshots for every command.
        snapshot=False,
    )

    build_subparser = subparsers.add_parser(
        "build", help="Build the development image."
    )

    build_subparser.add_argument(
        "--no-cache",
        action="store_true",
        help="Disable the build cache and refresh the base image.",
    )

    subparsers.add_parser(
        "status", help="List the project's containers and their status."
    )

    clean_parser = subparsers.add_parser(
        "clean",
        help=(
            "Delete containers, images, and agent homes left behind by "
            "deleted directories."
        ),
    )

    clean_scope = clean_parser.add_mutually_exclusive_group()

    clean_scope.add_argument(
        "--all",
        action="store_true",
        help=(
            "Remove every agentbox resource, including live projects "
            "and the shared OpenCode login."
        ),
    )

    clean_scope.add_argument(
        "--project",
        dest="project_only",
        action="store_true",
        help=(
            "Remove only this project's containers, image, and "
            "persistent agent home."
        ),
    )

    clean_parser.add_argument(
        "--yes",
        "-y",
        action="store_true",
        help="Remove without prompting for confirmation.",
    )

    return parser


COMMANDS = {
    "run": command_session,
    "shell": command_session,
    "auth": command_session,
    "build": command_build,
    "status": command_status,
}


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = build_parser()
    args = parser.parse_args(argv)

    # A bare `agentbox` means `agentbox run`; re-parsing keeps every default
    # in the parser rather than restating it here.
    if args.command is None:
        args = parser.parse_args([*argv, "run"])

    return args


def main(argv: list[str] | None = None) -> int:
    try:
        require_command("git")
        require_command("podman")

        args = parse_arguments(
            sys.argv[1:] if argv is None else argv
        )

        # `clean` sweeps across projects, so it must run from anywhere. Every
        # other command needs a project root.
        if args.command == "clean":
            command_clean(args)
            return 0

        root = find_project_root(args.project.expanduser().resolve())
        COMMANDS[args.command](args, root)

        return 0

    except AgentboxError as error:
        print(f"agentbox: {error}", file=sys.stderr)
        return 1

    except subprocess.CalledProcessError as error:
        print(
            f"agentbox: command failed with exit code {error.returncode}",
            file=sys.stderr,
        )
        return error.returncode

    except KeyboardInterrupt:
        print("\nagentbox: interrupted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    raise SystemExit(main())
